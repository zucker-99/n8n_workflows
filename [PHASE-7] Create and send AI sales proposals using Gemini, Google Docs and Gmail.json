      {
        "parameters": {
          "jsCode": "// Get the first input item\nconst input = $input.first().json;\n\n// Try to find the AI-generated text\nlet fullText =\n  input.content?.parts?.[0]?.text ||\n  input.content ||\n  input.text ||\n  input.output ||\n  input.response ||\n  \"\";\n\n// Make sure we actually received text\nif (typeof fullText !== \"string\" || !fullText.trim()) {\n  return {\n    AI_Summary: \"No AI summary generated.\",\n    AI_Solution: \"No solution generated.\",\n    Debug: JSON.stringify(input)\n  };\n}\n\n// Split at PROPOSED SOLUTION header\nconst parts = fullText.split(\n  /#{0,6}\\s*PROPOSED SOLUTION\\s*/i\n);\n\nlet summary = parts[0] || \"\";\nlet solution = parts[1] || \"\";\n\n// Remove EXECUTIVE SUMMARY header\nsummary = summary.replace(\n  /#{0,6}\\s*EXECUTIVE SUMMARY\\s*/i,\n  \"\"\n);\n\n// Remove \"Dear [Name],\" introduction\nsummary = summary.replace(\n  /^\\s*Dear\\s+.*?,\\s*/i,\n  \"\"\n);\n\n// Cleanup function\nconst cleanText = (text) => {\n  return text\n    // Remove markdown headers\n    .replace(/^#{1,6}\\s*/gm, \"\")\n\n    // Remove bold and italic markdown\n    .replace(/\\*\\*/g, \"\")\n    .replace(/\\*/g, \"\")\n\n    // Remove horizontal rules\n    .replace(/^\\s*---+\\s*$/gm, \"\")\n\n    // Normalize bullets\n    .replace(/^\\s*[-•]\\s*/gm, \"• \")\n\n    // Remove excessive blank lines\n    .replace(/\\n\\s*\\n\\s*\\n+/g, \"\\n\\n\")\n\n    .trim();\n};\n\nreturn {\n  AI_Summary: cleanText(summary),\n  AI_Solution: solution\n    ? cleanText(solution)\n    : \"No solution generated.\"\n};"
        },
